[{id:"ds",name:"Data Structures · Foundations",qs:[{c:"Sorting",k:"single",s:"Which sorting algorithm is stable?",o:["Quicksort","Merge sort","Heapsort","Selection sort"],a:[1],e:"Merge sort takes equal elements from the left run first, preserving their relative order."},{c:"Sorting",k:"single",s:"Which algorithm is fastest on a nearly sorted array?",o:["Insertion sort","Quicksort with first pivot","Heapsort","Merge sort"],a:[0],e:"Insertion sort moves each element only a few positions and approaches O(n) on nearly sorted input."},{c:"Search",k:"single",s:"In the worst case, how many comparisons does binary search need for 1,000 elements?",o:["10","32","100","500"],a:[0],e:"Each comparison halves the range: ⌈log₂1000⌉ = 10."},{c:"Search",k:"judge",s:"Binary search requires the array to be sorted first.",a:[0],e:"The algorithm can discard half the range only when values are ordered."},{c:"Complexity",k:"multi",s:"Which operations are O(1) on average? (Select all that apply)",o:["Hash lookup by key","Array access by index","Linked-list access at position k","Stack push and pop"],a:[0,1,3],e:"A linked list has no index; reaching position k requires walking from the head."},{c:"Complexity",k:"blank",s:"The lower bound for comparison sorting is O(n ______ n).",a:["log"],e:"Distinguishing n! permutations requires about n log n comparisons."},{c:"Trees",k:"single",s:"A complete binary tree with n nodes has height approximately?",o:["n","n/2","log₂n","√n"],a:[2],e:"The number of nodes can double at each level, so height grows as log₂n."},{c:"Trees",k:"multi",s:"Which are balanced search trees? (Select all that apply)",o:["AVL tree","Red-black tree","B+ tree","Binary heap"],a:[0,1,2],e:"A binary heap orders parents and children but does not provide search-tree ordering."},{c:"Graphs",k:"single",s:"Which algorithm handles single-source shortest paths with possible negative edges?",o:["Dijkstra","Bellman-Ford","Prim","Kruskal"],a:[1],e:"Bellman-Ford repeatedly relaxes edges and can also detect a negative cycle."},{c:"Graphs",k:"judge",s:"Depth-first search always finds the shortest path in an unweighted graph.",a:[1],e:"Breadth-first search explores by distance layers; DFS may reach a node through a longer path first."}]},{id:"safe",name:"Workplace Safety · General",qs:[{c:"Policy",k:"single",s:"Who holds primary responsibility for workplace safety?",o:["Safety coordinator","Floor supervisor","Company leadership","Employee committee"],a:[2],e:"Company leadership is accountable for establishing and maintaining the safety program."},{c:"Policy",k:"judge",s:"New employees must complete safety orientation before starting work.",a:[0],e:"Workers should be trained for the site, department, and role before beginning assigned duties."},{c:"Site",k:"multi",s:"Which personal protective equipment is normally required on a construction site?",o:["Hard hat","High-visibility vest","Safety footwear","Sunglasses"],a:[0,1,2],e:"Sunglasses are not general PPE; task-specific eye protection may be required."},{c:"Site",k:"single",s:"A coworker is receiving an electric shock. What should you do first?",o:["Pull them away by hand","Isolate power or use an insulated object","Begin CPR immediately","Call a supervisor first"],a:[1],e:"Isolate the electrical source before touching the person, then assess breathing and consciousness."},{c:"Fire",k:"single",s:"Which extinguisher is best for an early-stage electrical fire?",o:["Water","Carbon dioxide","Foam","Any extinguisher"],a:[1],e:"Carbon dioxide is non-conductive and leaves no residue on energized equipment."},{c:"Fire",k:"blank",s:"Before squeezing an extinguisher handle, remove the ______.",a:["safety pin"],e:"The handle cannot operate while the safety pin remains in place."},{c:"Emergency",k:"judge",s:"It is safe to use an elevator during a building fire.",a:[1],e:"Elevators can lose power or fill with smoke; use designated evacuation stairs."},{c:"Emergency",k:"multi",s:"Before entering a confined space, what must be done?",o:["Ventilate","Test the atmosphere","Authorize the work","Enter alone"],a:[0,1,2],e:"Confined-space work requires atmospheric testing, ventilation, authorization, and an attendant."}]}]